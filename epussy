-- Hitbox config
local HITBOX_MAX   = 15.2
local SERVER_REACH = 5.8

local function characterOf(player)
    local ch = player.Character
    if not ch then return nil end
    local hum = ch:FindFirstChildOfClass("Humanoid")
    local hrp = ch:FindFirstChild("HumanoidRootPart")
    if not hum or not hrp or hum.Health <= 0 then return nil end
    return ch, hum, hrp
end

local function friendly(player)
    if player == LP then return true end
    local mine = LP.Team
    return mine ~= nil and player.Team == mine
end

local function effectiveReach()
    local base = isHitbox and maxRange or 6
    return math.min(base, HITBOX_MAX)
end

local function collect(radius)
    local ch = characterOf(LP)
    if not ch then return {} end
    local origin = ch:GetPivot().Position
    local cap = math.min(radius, HITBOX_MAX)
    local out = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if not friendly(player) then
            local tch, hum, hrp = characterOf(player)
            if tch then
                local d = (hrp.Position - origin).Magnitude
                if d <= cap then
                    out[#out + 1] = { player = player, char = tch, hum = hum, root = hrp, dist = d }
                end
            end
        end
    end
    table.sort(out, function(a, b) return a.dist < b.dist end)
    return out
end

local function spoofPositionFor(target)
    local myRoot = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return target.root.Position end
    return myRoot.Position + myRoot.CFrame.LookVector * 2
end

local function reportOnce(seq, target)
    if not Combat or not Combat.HitReport then return false end
    if not target.root or not target.root:IsA("BasePart") then return false end
    if target.dist and target.dist > HITBOX_MAX then return false end
    local reportPos = target.root.Position
    if isHitbox then reportPos = spoofPositionFor(target) end
    local ok = pcall(function() Combat.HitReport:Fire(seq, target.root, reportPos) end)
    return ok
end

local function reportDouble(seq, target)
    if not reportOnce(seq, target) then return end
end

local function reportTarget(seq, target)
    if not target or not target.hum or target.hum.Health <= 0 then return end
    reportDouble(seq, target)
end

