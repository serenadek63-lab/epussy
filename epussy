HitWindow.Start = function(kind, limb, track, group, ...)
    local r = origHWStart(kind, limb, track, group, ...)

    if kind == "Attack" then
        -- No Delay Logic
        if isNoDelay and Active then
            Active.OpenFrame = true
            Active.CanAttack = true
        end

        -- Hitbox Logic (using the collect/report method from the first script)
        if isHitbox then
            local seq = Active and Active.Seq or 1
            local targets = collect(effectiveReach())
            if #targets > 0 then
                task.delay(0.02, function()
                    for _, t in ipairs(targets) do
                        if t.dist <= HITBOX_MAX then reportTarget(seq, t) end
                    end
                end)
            end
        end
    end

    return r
end

